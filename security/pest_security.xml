<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Module Category -->
        <record id="module_category_pest_control" model="ir.module.category">
            <field name="name">ServiPro - Control de Plagas</field>
            <field name="sequence">50</field>
        </record>

        <!-- Privilege (replaces category_id on groups in Odoo 19) -->
        <record id="privilege_pest_control" model="res.groups.privilege">
            <field name="name">Control de Plagas</field>
            <field name="description">Niveles de acceso para el módulo de control de plagas</field>
            <field name="category_id" ref="module_category_pest_control"/>
            <field name="sequence">10</field>
        </record>

        <!-- User Groups -->
        <record id="group_pest_client" model="res.groups">
            <field name="name">Cliente</field>
            <field name="privilege_id" ref="privilege_pest_control"/>
            <field name="sequence">5</field>
            <field name="comment">Solo lectura: puede ver estadisticas y reportes de su sede</field>
        </record>

        <record id="group_pest_technician" model="res.groups">
            <field name="name">Tecnico</field>
            <field name="privilege_id" ref="privilege_pest_control"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('group_pest_client'))]"/>
            <field name="comment">Puede registrar incidencias, evidencias e inspecciones</field>
        </record>

        <record id="group_pest_supervisor" model="res.groups">
            <field name="name">Supervisor</field>
            <field name="privilege_id" ref="privilege_pest_control"/>
            <field name="sequence">15</field>
            <field name="implied_ids" eval="[(4, ref('group_pest_technician'))]"/>
            <field name="comment">Acceso completo: gestion de sedes, planos, trampas, reportes y aprobaciones</field>
        </record>

        <!-- 🔑 La marca que distingue al PERSONAL DE SERVIPRO de la gente del cliente.
             Hace falta porque el rol NO alcanza: un técnico de ServiPro y un técnico de Bimbo
             tienen exactamente el mismo grupo «Tecnico», y lo único que hoy los diferencia es
             cuántas empresas tienen asignadas — un accidente de configuración, no una decisión.
             Deducirlo de ahí es construir una regla de acceso sobre una casualidad.

             Quien lleva esta marca ve TODAS las sedes de las empresas a las que pertenece.
             Quien no la lleva, solo las que tenga asignadas una por una. -->
        <record id="group_pest_staff" model="res.groups">
            <field name="name">Personal de ServiPro</field>
            <field name="privilege_id" ref="privilege_pest_control"/>
            <field name="sequence">20</field>
            <field name="comment">Trabaja para la empresa de servicio, no para un cliente: ve todas las sedes sin asignarlas una por una</field>
        </record>

        <!-- ══════════════════════════════════════════════════════════════
             CORTE POR SEDE  ·  decisión D9, fail-closed
             ══════════════════════════════════════════════════════════════
             Las reglas de arriba cortan por EMPRESA: que Bimbo no vea a Totis. Éstas cortan
             DENTRO de una empresa: que el jefe de planta de Azcapotzalco no vea Villahermosa.
             Con 16 sedes en Grupo Bimbo, es el corte que de verdad se pide.

             🔑 Van sobre `group_pest_client`, que TODOS heredan (Técnico y Supervisor lo
             implican), así que aplican a los tres roles. Al personal de ServiPro no le recortan
             nada porque `_sedes_visibles_del_usuario` les devuelve None.

             ⚠️ **Es fail-closed a propósito.** Cuando el método devuelve una lista vacía —un
             cliente sin sedes marcadas— el dominio queda `('sede_id', 'in', [])`, que no case
             con nada. Al revés, un alta a medias sería una fuga que nadie descubre.

             Y el criterio vive en UN método del usuario, no repetido once veces aquí: el día que
             cambie, el sitio que alguien olvide es por donde se escapa el dato. -->
        <record id="rule_pest_sede_sede" model="ir.rule">
            <field name="name">Sede: solo las sedes asignadas</field>
            <field name="model_id" ref="model_pest_sede"/>
            <field name="domain_force">[('id', 'in', user._sedes_visibles_del_usuario() or [])]</field>
            <!-- 🔴 `(5, 0, 0)` VACÍA la lista de grupos, y hace falta escribirlo: quitar
                 el campo del XML **no lo borra** —Odoo solo escribe lo que el XML declara—,
                 así que la regla se quedaría con su grupo y seguiría siendo de grupo.
                 Sin grupos es GLOBAL, y las globales se unen con AND a las de empresa. Como
                 regla de grupo se uniría con OR y no recortaría nada. -->
            <field name="groups" eval="[(5, 0, 0)]"/>
        </record>

        <record id="rule_pest_blueprint_sede" model="ir.rule">
            <field name="name">Plano: solo las sedes asignadas</field>
            <field name="model_id" ref="model_pest_blueprint"/>
