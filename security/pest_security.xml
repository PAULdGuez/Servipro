<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Module Category -->
        <record id="module_category_pest_control" model="ir.module.category">
            <field name="name">ServiPro - Control de Plagas</field>
            <field name="sequence">50</field>
        </record>

        <!-- Privilege (replaces category_id on groups in Odoo 19) -->
        <record id="privilege_pest_control" model="res.groups.privilege">
            <field name="name">Control de Plagas</field>
            <field name="description">Niveles de acceso para el módulo de control de plagas</field>
            <field name="category_id" ref="module_category_pest_control"/>
            <field name="sequence">10</field>
        </record>

        <!-- User Groups -->
        <record id="group_pest_client" model="res.groups">
            <field name="name">Cliente</field>
            <field name="privilege_id" ref="privilege_pest_control"/>
            <field name="sequence">5</field>
            <field name="comment">Solo lectura: puede ver estadisticas y reportes de su sede</field>
        </record>

        <record id="group_pest_technician" model="res.groups">
            <field name="name">Tecnico</field>
            <field name="privilege_id" ref="privilege_pest_control"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('group_pest_client'))]"/>
            <field name="comment">Puede registrar incidencias, evidencias e inspecciones</field>
        </record>

        <record id="group_pest_supervisor" model="res.groups">
            <field name="name">Supervisor</field>
            <field name="privilege_id" ref="privilege_pest_control"/>
            <field name="sequence">15</field>
            <field name="implied_ids" eval="[(4, ref('group_pest_technician'))]"/>
            <field name="comment">Acceso completo: gestion de sedes, planos, trampas, reportes y aprobaciones</field>
        </record>

        <!-- Record Rules: Multi-Empresa -->
        <record id="rule_pest_sede_company" model="ir.rule">
            <field name="name">Sede: Solo empresa del usuario</field>
            <field name="model_id" ref="model_pest_sede"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_pest_client'))]"/>
        </record>
        <record id="rule_pest_blueprint_company" model="ir.rule">
            <field name="name">Plano: Solo empresa del usuario</field>
            <field name="model_id" ref="model_pest_blueprint"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_pest_client'))]"/>
        </record>
        <!-- La zona no tiene company_id propio: se filtra a traves de su plano, que si lo
             tiene. Sin esta regla un cliente veia las zonas de las plantas de otros clientes
             (comprobado en runtime el 2026-09-03). El ADR-003 la habia excluido diciendo que
             el modelo "no existe aun"; si existe, y desde antes de aquel ADR. -->
        <record id="rule_pest_blueprint_zone_company" model="ir.rule">
            <field name="name">Zona del plano: Solo empresa del usuario</field>
            <field name="model_id" ref="model_pest_blueprint_zone"/>
            <field name="domain_force">['|', ('blueprint_id.company_id', '=', False), ('blueprint_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_pest_client'))]"/>
        </record>
        <record id="rule_pest_zone_company" model="ir.rule">
            <field name="name">Ubicación: Solo empresa del usuario</field>
            <field name="model_id" ref="model_pest_zone"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_pest_client'))]"/>
        </record>
        <record id="rule_pest_trap_company" model="ir.rule">
            <field name="name">Trampa: Solo empresa del usuario</field>
            <field name="model_id" ref="model_pest_trap"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_pest_client'))]"/>
        </record>
        <record id="rule_pest_incident_company" model="ir.rule">
            <field name="name">Incidencia: Solo empresa del usuario</field>
            <field name="model_id" ref="model_pest_incident"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_pest_client'))]"/>
        </record>
        <record id="rule_pest_inspection_company" model="ir.rule">
            <field name="name">Inspeccion: Solo empresa del usuario</field>
            <field name="model_id" ref="model_pest_inspection"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_pest_client'))]"/>
        </record>
        <record id="rule_pest_complaint_company" model="ir.rule">
            <field name="name">Queja: Solo empresa del usuario</field>
            <field name="model_id" ref="model_pest_complaint"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_pest_client'))]"/>
        </record>
        <record id="rule_pest_evidence_company" model="ir.rule">
            <field name="name">Evidencia: Solo empresa del usuario</field>
            <field name="model_id" ref="model_pest_evidence"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_pest_client'))]"/>
        </record>
        <record id="rule_pest_trap_state_company" model="ir.rule">
            <field name="name">Estado Trampa: Solo empresa del usuario</field>
            <field name="model_id" ref="model_pest_trap_state"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_pest_client'))]"/>
        </record>
        <record id="rule_pest_trap_movement_company" model="ir.rule">
            <field name="name">Movimiento Trampa: Solo empresa del usuario</field>
            <field name="model_id" ref="model_pest_trap_movement"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_pest_client'))]"/>
        </record>
    </data>
</odoo>
